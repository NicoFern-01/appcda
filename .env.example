# ============================================================
# Variables de entorno para la configuración de Firebase.
# Copia este archivo a `.env` y completa con tus valores.
# La app los centralizará aquí (hoy están dispersos en db.js).
# En producción se inyectan en el build de Vite (prefijo VITE_).
# ============================================================

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-project-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Sincronización de usuarios: ya NO existe bandera (fue eliminada). El
# directorio SIEMPRE usa la nube cuando hay sesión; la defensa de escritura
# son las reglas de Firestore (firestore.rules), no una variable del cliente.
# Credenciales SOLO del harness E2E (Playwright).
# SIN prefijo VITE_ a proposito: Vite solo inyecta en el bundle del navegador
# las variables VITE_*, de modo que esta contrasena NUNCA se publica en dist/.
CDA_E2E_USER=admin
CDA_E2E_PASSWORD=cambia_esta_contrasena_de_prueba
