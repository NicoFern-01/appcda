rules_version = '2';

// ============================================================
// REGLAS DE FIRESTORE — Control CDA
// ============================================================
// La API key de Firebase es publica POR DISENO (va en el bundle). Por eso
// estas reglas son la UNICA defensa real: sin ellas, cualquiera que abra la
// consola del navegador puede escribirse `rol: "admin"` y concede acceso total.
//
// MODELO DE IDENTIDAD:
//   Firebase Auth  -> identidad (email). El local-part del email ES el username.
//   usuarios/{id}  -> perfil (nombre, rol, activo, permisos). El id es el
//                     username en minusculas.
//
// La funcion `esAdmin()` resuelve el rol desde el propio documento de perfil,
// de modo que el cliente NO puede auto-asignarse admin (eso exigiria escribir
// primero su propio perfil).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function miEmail() {
      // `lower()` y NO `toLowerCase()`: los metodos de las reglas de
      // Firestore se escriben en minuscula. Usar el nombre de JavaScript
      // produce "Invalid function name" y la consola rechaza TODO el archivo.
      return request.auth.token.email.lower();
    }

    // Username en minusculas = id de documento.
    function miId() {
      return request.auth.token.email.split('@')[0].lower();
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(miId())).data;
    }

    // ============================================================
    // CUENTAS ADMINISTRADORAS ANCLA
    // ============================================================
    // Estas cuentas son admin INDEPENDIENTIENTE de si tienen documento de perfil.
    //
    // MOTIVO (rompe el deadlock de arranque): el rol se resuelve leyendo el
    // documento `usuarios/{id}`. Sin ese documento, nadie es admin. Pero las
    // reglas exigen un admin existente para crear documentos. Resultado: sin
    // documento inicial no hay admin, y sin admin no se puede crear el
    // documento inicial -> la app queda inutilizable (nadie puede administrar
    // usuarios). Estas cuentas ancla pueden crear su propio perfil y asi
    // desbloquear el sistema.
    //
    // DEBE MANTENERSE SINCRONIZADA con ADMINS_ANCLA en
    // src/services/authCredentials.js. Si se agrega un email acá, agregalo
    // también en el JS (o el usuario no podrá crear su perfil).
    function esAdminAncla() {
      return signedIn() && miEmail() in [
        'admin@controlcda.com'
      ];
    }

    function esAdmin() {
      return esAdminAncla() ||
             (signedIn() && miPerfil() != null && miPerfil().rol == 'admin' && miPerfil().activo == true);
    }

    // Roles que pueden escribir datos operativos. La app tiene perfiles
    // 'editor' y 'supervisor' que SI editan sus modulos con los permisos
    // granulares de la matriz: excluirlos de los datos les romperia el uso
    // diario. 'viewer' queda excluido (solo lectura).
    function puedeEscribirDatos() {
      return signedIn()
          && miPerfil() != null
          && miPerfil().activo == true
          && miPerfil().rol in ['admin', 'editor', 'supervisor'];
    }

    // Regla anti-autoescalada: un usuario NO puede escribirse a si mismo con
    // permisos distintos a los que ya tiene. Impide que cualquiera se declare
    // admin. Los admins legitimos si pueden editar a otros.
    function noAutoescalada() {
      return request.resource.data.rol == resource.data.rol
          || esAdmin();
    }

    // ---------- coleccion usuarios (perfiles) ----------
    match /usuarios/{userId} {
      // Cualquier usuario autenticado puede LEER perfiles (necesario para que
      // el listado y los permisos funcionen en la app).
      allow read: if signedIn();

      // CREAR: cualquier admin legitimo puede crear el perfil de OTRO usuario
      // (alta normal desde Configuracion). Antes exigia `userId == miId()`, lo
      // que hacia IMPOSIBLE dar de alta a otra persona: el admin podia crear
      // unicamente su propio documento. Ademas se exige que el documento sea
      // coherente con su id (username = local-part del email) para que las
      // reglas puedan resolver el perfil por email.
      allow create: if esAdmin()
                    && request.resource.data.rol in ['admin', 'editor', 'viewer', 'supervisor']
                    && request.resource.data.email is string
                    && request.resource.data.email.split('@')[0].lower() == userId
                    && request.resource.data.username == userId;

      // EDITAR: solo admin. Un usuario NO puede editar su propio perfil en la nube
      // (los cambios de permisos los hace el admin; asi se evita la autoescalada).
      allow update: if esAdmin() && noAutoescalada();

      // BORRAR: solo admin, y nunca el propio perfil (evita quedar sin admin).
      allow delete: if esAdmin() && userId != miId();
    }

    // ---------- resto de colecciones ----------
    // LECTURA: cualquier usuario autenticado.
    // ESCRITURA: solo roles operativos (admin/editor/supervisor activos).
    // Antes era un comodin que permitia a CUALQUIER usuario autenticado
    // (incluidos viewers) escribir en cualquier coleccion.
    match /{collection}/{docId} {
      allow read: if signedIn();
      allow write: if puedeEscribirDatos();
    }
  }
}
